    "An attempt to create an already existing file or directory has been made" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byl proveden pokus o vytvoření již existujícího souboru nebo adresáře"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde versucht, eine bereits vorhandene Datei oder ein bereits vorhandenes Verzeichnis zu erstellen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha intentado crear un archivo o directorio que ya existe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une tentative de création d'un fichier ou d'un répertoire déjà existant a été effectuée"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
